{
  "name": "@local/paper-tool",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "description": "Paper workbench for DSH: local library, full-text search, PDF reader, evidence matrix and traceable review generation — no external software required",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.mjs",
    "lib/**/*",
    "locale/*.json",
    "styles/*.csl",
    "styles/*.xml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md"
  ],
  "scripts": {
    "install-plugin": "node install.mjs",
    "test": "node test/all.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "pdfjs-dist": "6.3.289",
    "citeproc": "2.4.63"
  }
}
